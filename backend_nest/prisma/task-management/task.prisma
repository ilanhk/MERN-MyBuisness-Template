enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELED

  @@map("task_status")
}

enum TaskType {
  ORDER
  TASK
  TICKET

  @@map("task_type")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("task_priority")
}

/// A unit of work: a customer order to fulfil, an internal task, or a support ticket.
model Task {
  id           String  @id @default(uuid()) @db.Uuid
  companyId    String  @map("company_id") @db.Uuid
  taskNumber   Int     @map("task_number") // per company: 1, 2, 3...
  departmentId String? @map("department_id") @db.Uuid
  assigneeId   String? @map("assignee_id") @db.Uuid
  reporterId   String? @map("reporter_id") @db.Uuid
  parentId     String? @map("parent_id") @db.Uuid // subtasks

  // What the task is about (optional links)
  orderId         String? @map("order_id") @db.Uuid
  supplierId      String? @map("supplier_id") @db.Uuid
  supplierOrderId String? @map("supplier_order_id") @db.Uuid

  title       String
  description String?
  status      TaskStatus   @default(TODO)
  type        TaskType     @default(TASK)
  priority    TaskPriority @default(MEDIUM)

  dueAt       DateTime? @map("due_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department    Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignee      User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter      User?            @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  parent        Task?            @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks      Task[]           @relation("TaskSubtasks")
  order         Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  supplier      Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierOrder SupplierOrder?   @relation(fields: [supplierOrderId], references: [id], onDelete: SetNull)
  comments      TaskComment[]
  attachments   TaskAttachment[]

  @@unique([companyId, taskNumber])
  @@index([companyId, status, priority, createdAt]) // board / filtered list
  @@index([companyId, assigneeId, status]) // "my open tasks"
  @@index([companyId, departmentId, status]) // department view
  @@index([companyId, dueAt]) // due-soon and overdue
  @@index([companyId, type, status]) // orders vs tickets lists
  @@index([orderId])
  @@index([supplierId])
  @@index([supplierOrderId])
  @@index([parentId])
  @@index([reporterId])
  @@map("tasks")
}
