enum SupplierType {
  MANUFACTURER @map("manufacturer")
  TRADER       @map("trader")

  @@map("supplier_type")
}

model Supplier {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name  String
  email String
  phone String
  type  SupplierType @default(MANUFACTURER)

  contactFullName String? @map("contact_full_name")
  contactEmail    String? @map("contact_email")
  contactPhone    String? @map("contact_phone")

  internationalCertificates String[] @default([]) @map("international_certificates")
  photos                    String[] @default([])
  productCategories         String[] @default([]) @map("product_categories")

  annualExportVolume      Int?    @map("annual_export_volume")
  productionCapacity      String? @map("production_capacity")
  workerNumber            Int?    @map("worker_number")
  qcNumber                Int?    @map("qc_number")
  ownerOrAuthorizedPerson String? @map("owner_or_authorized_person")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  
  products Product[]

  @@index([companyId, createdAt])
  @@index([companyId, type])
  @@index([companyId, name])
  @@index([productCategories], type: Gin)
  @@map("suppliers")
}