model MessageConsent {
  id          String         @id @default(uuid()) @db.Uuid
  companyId   String         @map("company_id") @db.Uuid
  channel     MessageChannel
  address     String
  userId      String?        @map("user_id") @db.Uuid
  source      String // "checkout_checkbox", "signup_form", "sms_keyword"
  consentText String?        @map("consent_text") // the exact wording they agreed to
  ipAddress   String?        @map("ip_address")
  grantedAt   DateTime       @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt   DateTime?      @map("revoked_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([companyId, channel, address])
  @@map("message_consents")
}
