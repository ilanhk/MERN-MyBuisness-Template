enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
  REFUNDED

  @@map("order_status")
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  companyId   String      @map("company_id") @db.Uuid
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  userId      String?     @map("user_id") @db.Uuid
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderNumber Int         @map("order_number") // human-friendly, per company
  status      OrderStatus @default(PENDING)

  userEmail    String  @map("user_email") // snapshot at purchase time
  currency     String  @db.Char(3)
  subtotal     Decimal @db.Decimal(12, 2)
  shippingCost Decimal @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  taxTotal     Decimal @default(0) @map("tax_total") @db.Decimal(12, 2)
  total        Decimal @db.Decimal(12, 2)

  shippingAddress Json    @map("shipping_address") // snapshot, not a live reference
  billingAddress  Json?   @map("billing_address")
  notes           String?

  paymentProviderId String?  @map("payment_provider_id") // e.g. Stripe payment intent id
  placedAt          DateTime @default(now()) @map("placed_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items          OrderItem[]
  shipments      Shipment[]
  companyReviews CompanyReview[]
  payments       Payment[]
  tasks          Task[]

  @@unique([companyId, orderNumber])
  @@index([companyId, status, placedAt])
  @@index([companyId, placedAt])
  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?  @map("product_id") @db.Uuid
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Snapshots: these must not change if the product is edited or deleted later
  productName String  @map("product_name")
  sku         String?
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 2)

  shipments      ShipmentItem[]
  productReviews ProductReview[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}
