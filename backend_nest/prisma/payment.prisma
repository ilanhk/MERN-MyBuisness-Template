enum PaymentStatus {
  PENDING
  REQUIRES_ACTION // e.g. 3D Secure
  SUCCEEDED
  FAILED
  CANCELED
  PARTIALLY_REFUNDED
  REFUNDED

  @@map("payment_status")
}

model Payment {
  id        String        @id @default(uuid()) @db.Uuid
  companyId String        @map("company_id") @db.Uuid
  orderId   String        @map("order_id") @db.Uuid
  userId    String?       @map("user_id") @db.Uuid
  status    PaymentStatus @default(PENDING)

  provider          String  @default("stripe")
  providerPaymentId String  @map("provider_payment_id") // e.g. Stripe PaymentIntent id
  method            String? // "card", "paypal", ...
  cardBrand         String? @map("card_brand") // display only
  cardLast4         String? @map("card_last4") @db.Char(4)

  amount         Decimal  @db.Decimal(12, 2)
  amountRefunded Decimal  @default(0) @map("amount_refunded") @db.Decimal(12, 2)
  platformFee    Decimal? @map("platform_fee") @db.Decimal(12, 2)
  currency       String   @db.Char(3)

  failureCode    String?   @map("failure_code")
  failureMessage String?   @map("failure_message")
  paidAt         DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  refunds Refund[]

  @@unique([provider, providerPaymentId])
  @@index([orderId])
  @@index([companyId, status, createdAt])
  @@index([userId])
  @@map("payments")
}

model Refund {
  id               String   @id @default(uuid()) @db.Uuid
  paymentId        String   @map("payment_id") @db.Uuid
  providerRefundId String   @unique @map("provider_refund_id")
  amount           Decimal  @db.Decimal(12, 2)
  reason           String?
  createdById      String?  @map("created_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@map("refunds")
}
